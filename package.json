{
  "name": "huaweicloud-devkit-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "huaweicloud-devkit 测试仓库（用例矩阵 / 每日测试 / 契约单测）",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/unit/*.test.mjs",
    "test:replay": "node eval/replay/replay.mjs",
    "test:plan": "node test-manager/run-plan.mjs",
    "test:plan:publish": "node test-manager/run-plan.mjs && node test-manager/scripts/publish-missions.mjs",
    "test:python": "python -m unittest discover -s test/python -p 'test_*.py'",
    "test:trend": "python scripts/trend_metrics.py"
  }
}