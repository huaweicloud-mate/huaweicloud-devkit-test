+++ b/test/service-catalog.test.mjs
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { callTool } from '../plugins/huaweicloud-core/src/tools.mjs';
+
+async function catalog(intent) {
+  return callTool('huaweicloud_service_catalog', { intent });
+}
+
+// Regression guards for Issue #82: routing must survive whitespace tokenization.
+test('service_catalog keeps whitespace-separated English token matching', async () => {
+  const result = await catalog('list all ecs instances');
+  assert.ok(result.recommendedServices.includes('ECS'),
+    `expected ECS in ${JSON.stringify(result.recommendedServices)}`);
+});
+
+test('service_catalog keeps fallback when nothing matches', async () => {
+  const result = await catalog('讲个笑话');
+  assert.deepEqual(result.recommendedServices, ['Run hcloud --help to list available services.']);
+});
+
+// Issue #82 case 1: Chinese-only intent uses the colloquial alias 云主机 (cloud host = ECS).
+test('service_catalog routes Chinese intent with 云主机 to ECS (#82)', async () => {
+  const result = await catalog('帮我查一下我账号在华北北京四有哪些云主机');
+  assert.ok(result.recommendedServices.includes('ECS'),
+    `expected ECS in ${JSON.stringify(result.recommendedServices)}`);
+});
+
+// Issue #82 case 2: ASCII service abbreviation glued to Chinese text must still match.
+test('service_catalog extracts ASCII abbreviation glued to Chinese text (#82)', async () => {
+  const ecs = await catalog('查看ECS');
+  assert.ok(ecs.recommendedServices.includes('ECS'),
+    `expected ECS in ${JSON.stringify(ecs.recommendedServices)}`);
+  const obs = await catalog('创建OBS桶');
+  assert.ok(obs.recommendedServices.includes('OBS'),
+    `expected OBS in ${JSON.stringify(obs.recommendedServices)}`);
+});
+
+// Eval-set-v1 (eval/prompts/eval-set-v1.csv) routing expectations, EXP-E02..EXP-E15.
+test('service_catalog covers eval-set-v1 routing expectations', async () => {
+  const cases = [
+    ['创建一台 2C4G 的 Ubuntu 云服务器 规格通用型', 'ECS'],
+    ['把本地 dist 目录部署成一个公网静态网站', 'OBS'],
+    ['给这台服务器绑定一个弹性公网IP', 'EIP'],
+    ['看一下我的云数据库MySQL实例的状态', 'RDS'],
+    ['创建一个 Redis 缓存实例用于会话存储', 'DCS'],
+    ['给生产环境的服务器配置一个每日备份策略', 'CBR'],
+    ['开设一个 Kubernetes 集群用于微服务部署', 'CCE'],
+    ['部署一个函数处理图片自动压缩', 'FunctionGraph'],
+    ['查一下我账号这个月的费用情况', 'BSS'],
+    ['把应用日志指标推送到云监控告警', 'CES'],
+    ['申请HTTPS证书并配置到我的域名', 'ELB'],
+    ['我账号下的用户都有哪些权限 帮我审计一下', 'IAM'],
+    ['帮我领一下华为云的代金券', 'Incentive Voucher'],
+  ];
+  for (const [intent, expected] of cases) {
+    const result = await catalog(intent);
+    assert.ok(result.recommendedServices.includes(expected),
+      `${intent} -> expected ${expected} in ${JSON.stringify(result.recommendedServices)}`);
+  }
+});
