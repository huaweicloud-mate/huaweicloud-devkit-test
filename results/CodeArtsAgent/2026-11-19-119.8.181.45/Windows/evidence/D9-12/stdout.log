                  "type": "string"
                },
                "username": {
                  "description": "Login username (default: root)",
                  "type": "string"
                },
                "timeout_ms": {
                  "description": "Execution timeout in milliseconds (sync default: 120000; async bounds only the start exec, default 30000 — the async command itself is unbounded and outlives the exec)",
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "approvalToken": {
                  "description": "Required in token-approval mode (from the minting face — the plan tool, or the approval gate's USER_CONFIRMATION_REQUIRED envelope); omit in ask mode, where the server-run gate confirms at run time.",
                  "type": "string"
