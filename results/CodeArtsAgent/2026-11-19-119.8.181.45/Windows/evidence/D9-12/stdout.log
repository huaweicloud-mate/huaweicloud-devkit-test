                    "number",
                    "string",
                    "null"
                  ]
                },
                "timeout_ms": {
                  "description": "Execution timeout in milliseconds (default: 30000; auto-raised to wait_ms + 15000 headroom, never below the default)",
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "task_id"
