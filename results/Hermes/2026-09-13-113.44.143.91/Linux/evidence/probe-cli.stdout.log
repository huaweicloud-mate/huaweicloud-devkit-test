===== D1-8 生成的 MCP 配置 (config.yaml) =====
mcp_servers:
  huaweicloud-devkit:
    command: "node"
    args: ["/tmp/hdk-cli-iso.QkUQdG/huaweicloud-plugins/src/mcp-server.mjs"]
    env:
      HUAWEICLOUD_AGENT_TOOLKIT_MODE: "local"
      HCLOUD_BIN: "/home/zhangshuang/.local/bin/hcloud"

hooks:
  pre_tool_call:
    - matcher: "terminal"
      command: "python3 /tmp/hdk-cli-iso.QkUQdG/huaweicloud-plugins/hooks/huaweicloud-safety.py"
      timeout: 5
      fail_closed: true
    - matcher: "skill_view|skills_list|skill_manage|terminal"
      command: "python3 /tmp/hdk-cli-iso.QkUQdG/huaweicloud-plugins/hooks/huaweicloud-telemetry.py"
      timeout: 5
      fail_closed: false

