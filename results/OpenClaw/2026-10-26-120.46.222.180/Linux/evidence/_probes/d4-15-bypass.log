[plain] decision=deny risk=write | hcloud ecs DeleteServer --force
[case] decision=deny risk=write | hcloud ecs deleteserver --force
[concat-quote] decision=deny risk=write | hcloud ecs DeleteServ"er" --force
[base64] decision=deny risk=execution | echo ZWNobyBoaQo= | base64 -d | bash
