{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/huaweicloud-safety.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*huaweicloud.*|huaweicloud_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/huaweicloud-safety.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
