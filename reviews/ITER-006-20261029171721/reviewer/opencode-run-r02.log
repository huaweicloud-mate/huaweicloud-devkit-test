import csv
csv.field_size_limit(10000000)
def load(p):
    rows=list(csv.reader(open(p,encoding='utf-8-sig')))
    h=rows[0]
    return h,{r[0]:dict(zip(h,r)) for r in rows[1:]}
mh,master=load('test-cases/design/用例矩阵-设计级.csv')
ch,cand=load('reviews/ITER-006-20261029171721/hermes/candidate-matrix.csv')
GATED=['auth_status','auth_init','auth_switch','check_cli','show_profile_redacted','list_operations','list_regions','run_readonly_command','plan_cli_command','run_approved_command','service_catalog','sandbox_connect','voucher_claim','competition_voucher_claim']
def norm(t):
    t=t.strip()
    if t.startswith('huaweicloud_'): t=t[len('huaweicloud_'):]
    return t
def tools_set(s):
    toks=[norm(t) for t in s.replace('；','/').replace(';','/').replace(',','/').split('/') if t.strip()]
    return set(toks)
# over-inclusion: candidate vendor-gate cases whose tool set intersects GATED = empty
over=[]
for cid,r in cand.items():
    if '已建立 vendor 确认' in r['前置条件']:
        ts=tools_set(r['关联工具'])
        if not (ts & set(GATED)):
            over.append((cid, ts))
print('OVER-INCLUSION (vendor case w/ no gated tool):', over)
# under-inclusion: master cases with gated tool but NOT in candidate as vendor-gate
under=[]
for mid,r in master.items():
    ts=tools_set(r['关联工具'])
    if ts & set(GATED):
        if mid not in cand:
            under.append((mid, ts & set(GATED), r['优先级']))
        elif '已建立 vendor 确认' not in cand[mid]['前置条件']:
            under.append((mid, 'IN-CANDIDATE-BUT-NO-GATE', ts&set(GATED)))
print('UNDER-INCLUSION (master gated-tool case missing from candidate or no gate):')
for u in under: print('  ',u)
print('total under:', len(under))
