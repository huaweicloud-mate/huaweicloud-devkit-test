# For vendor gate cases: verify three-piece set + assertion uniqueness
bad3=[]; badassert=[]; badtool=[]
for cid,r in cand.items():
    if '已建立 vendor 确认' not in r['前置条件']:
        continue
    pre=r['前置条件']; steps=r['操作步骤']; exp=r['预期结果']; tools=r['关联工具']
    ok3=True
    if '已建立 vendor 确认（vendorConfirmed=用户确立华为云的原文引用）' not in pre: ok3=False
    if not steps.startswith('⓪建立 vendor 确认'): ok3=False
    if not exp.startswith('（gate 放行后）'): ok3=False
    if not ok3: bad3.append((cid,'three-piece-incomplete'))
    # assertion uniqueness: strip prefix and compare to master verbatim
    stripped=exp[len('（gate 放行后）'):]
    if cid in master and master[cid]['预期结果']!=stripped:
        badassert.append((cid,'assertion-diff', stripped[:50], master[cid]['预期结果'][:50]))
    # tools must all be gated
    toks=[t.strip() for t in tools.replace('；','/').replace(';','/').replace(',','/').split('/') if t.strip()]
    for t in toks:
        tn=t
        if tn.startswith('huaweicloud_'): tn=tn[len('huaweicloud_'):]
        if tn in ('voucher_status','auth_sync','auth_confirm'):
            pass
    # check at least one gated tool present and flag if tool list contains only ungated
print('three-piece failures:', len(bad3), bad3[:5])
print('assertion diffs:', len(badassert))
for b in badassert: print('  ',b)
