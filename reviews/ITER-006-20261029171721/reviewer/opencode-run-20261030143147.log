print('master header cols:', len(mh))
print('cand header cols:', len(ch))
print('cand header == master header:', mh==ch)
dup = [x for x in set(cand_ids) if cand_ids.count(x)>1]
print('dup in cand:', dup)
notin = [x for x in cand_ids if x not in set(master_ids)]
print('cand IDs NOT in master:', notin)
