import csv, sys
def read_ids(path):
    ids=[]
    with open(path, encoding='utf-8-sig') as f:
        r=csv.reader(f)
        header=next(r)
        for row in r:
            if row and row[0].strip():
                ids.append(row[0].strip())
    return ids, header

master_ids, mh = read_ids('test-cases/design/用例矩阵-设计级.csv')
